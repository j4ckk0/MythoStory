<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- the server and the WebView talk over a socket, on 127.0.0.1: Android wants this even for its own loopback -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- the speaker button (SpeechBridge): Android 11 and later show an app only the text-to-speech engines it asks for -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".MythoStoryApplication"
        android:label="@string/app_name"
        android:icon="@android:drawable/sym_def_app_icon"
        android:theme="@style/MythoStory"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- configChanges: rotating or resizing keeps the activity, and the page's state with it -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
