<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jtools</groupId>
    <artifactId>mythostory-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>mythostory</artifactId>
  <packaging>jar</packaging>

  <name>MythoStory desktop</name>
  <description>The desktop program: starts the server on localhost and opens the browser on it. Its jar, desktop/target/mythostory.jar, embeds everything; the distributions add a runtime, Piper and its voices.</description>

  <properties>
    <!-- the program's module, for jtools-parent: this module's jar becomes the one jar, embedding everything -->
    <jtools.app.skip>false</jtools.app.skip>
    <!-- the desktop runs on the bundled runtime, never on Android: the JDK's own bytecode -->
    <maven.compiler.release>25</maven.compiler.release>
    <kotlin.compiler.jvmTarget>25</kotlin.compiler.jvmTarget>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jtools</groupId>
      <artifactId>mythostory-backend</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jtools</groupId>
      <artifactId>mythostory-frontend</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-test-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>mythostory</finalName>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
      </plugin>
      <!-- the libraries the jar carries and their licences, from their poms: licences/THIRD-PARTY.txt in the jar,
           which the help page lists (backend: /api/licences) — never typed by hand, never out of date -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <executions>
          <!-- jtools-parent's Apache header on the sources is the framework's own licence, not MythoStory's -->
          <execution>
            <id>add-license-headers</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>third-party</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>add-third-party</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/licences</outputDirectory>
              <excludedGroups>org\.jtools</excludedGroups>
              <excludedScopes>test,provided,system</excludedScopes>
              <sortArtifactByName>true</sortArtifactByName>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- jtools-parent's one jar, with every jar's META-INF/services merged: Ktor and logback find their parts
           through ServiceLoader -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <id>jtools-embed</id>
            <configuration>
              <transformers combine.children="append">
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      mvn package -Pdist (scripts/linux/package.sh)
      jtools-parent's profile links a runtime per platform (jlink, from the jmods in external/) and makes the
      launchers; this one then makes the archives again with Piper and its voices beside them (external/, deployed
      by scripts/linux/setup.sh), under the same names, into releases/ at the root:
        releases/mythostory-<version>-windows.zip    MythoStory.exe, mythostory.bat
        releases/mythostory-<version>-linux.tar.gz   mythostory.sh
    -->
    <profile>
      <id>dist</id>
      <properties>
        <piper.archives>${maven.multiModuleProjectDirectory}/external</piper.archives>
        <release.dir>${maven.multiModuleProjectDirectory}/releases</release.dir>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <executions>
              <execution>
                <id>unpack-piper</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <!-- Piper and its voices (external/, scripts/linux/setup.sh): the voice that reads the stories -->
                    <fail message="no ${piper.archives}/piper-linux.tar.gz or piper-windows.zip: run scripts/linux/setup.sh (see README: Externals)">
                      <condition>
                        <not><and>
                          <available file="${piper.archives}/piper-linux.tar.gz"/>
                          <available file="${piper.archives}/piper-windows.zip"/>
                          <!-- each language's default voice (voices.json), at least -->
                          <available file="${piper.archives}/voices/fr_FR-siwis-medium.onnx"/>
                          <available file="${piper.archives}/voices/en_GB-alba-medium.onnx"/>
                        </and></not>
                      </condition>
                    </fail>
                    <!-- the system tar, not Ant's: Piper's libraries are a soname and symlinks to it, which Ant
                         would write as empty files, and its programs would lose their executable bit -->
                    <delete dir="${project.build.directory}/piper"/>
                    <mkdir dir="${project.build.directory}/piper/linux"/>
                    <exec executable="tar" failonerror="true">
                      <arg value="-xzf"/>
                      <arg value="${piper.archives}/piper-linux.tar.gz"/>
                      <arg value="-C"/>
                      <arg value="${project.build.directory}/piper/linux"/>
                      <arg value="--strip-components"/>
                      <arg value="1"/>
                    </exec>
                    <unzip dest="${project.build.directory}/piper/windows">
                      <fileset dir="${piper.archives}" includes="piper-windows.zip"/>
                      <cutdirsmapper dirs="1"/>
                    </unzip>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- after jtools-parent's distributions in the same phase (a parent's plugins run before a module's own):
                 the same archives, Piper and the voices added -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-assembly-plugin</artifactId>
            <executions>
              <execution>
                <id>dist-piper</id>
                <phase>package</phase>
                <goals>
                  <goal>single</goal>
                </goals>
                <configuration>
                  <finalName>${project.artifactId}-${project.version}</finalName>
                  <appendAssemblyId>true</appendAssemblyId>
                  <outputDirectory>${release.dir}</outputDirectory>
                  <descriptors>
                    <descriptor>src/assembly/windows.xml</descriptor>
                    <descriptor>src/assembly/linux.xml</descriptor>
                  </descriptors>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
