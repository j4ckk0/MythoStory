<?xml version="1.0" encoding="UTF-8"?>
<!-- Linux distribution: jtools-parent's — the jar, its launcher, the runtime jlink linked — with Piper and its voices. -->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
  <id>linux</id>
  <formats>
    <format>tar.gz</format>
  </formats>
  <baseDirectory>${jtools.app.id}-${project.version}</baseDirectory>

  <files>
    <file>
      <source>${project.build.directory}/${project.build.finalName}.jar</source>
      <destName>${jtools.app.id}.jar</destName>
      <fileMode>0644</fileMode>
    </file>
    <!-- the launcher jtools-parent's distributions made -->
    <file>
      <source>${project.build.directory}/jtools-dist-work/unix/app.sh</source>
      <destName>${jtools.app.id}.sh</destName>
      <lineEnding>unix</lineEnding>
      <fileMode>0755</fileMode>
    </file>
    <file>
      <source>src/dist/${jtools.app.id}.ini</source>
      <lineEnding>unix</lineEnding>
      <fileMode>0644</fileMode>
    </file>
    <file>
      <source>${maven.multiModuleProjectDirectory}/README.md</source>
      <lineEnding>unix</lineEnding>
      <fileMode>0644</fileMode>
    </file>
    <file>
      <source>${maven.multiModuleProjectDirectory}/LICENSE</source>
      <lineEnding>unix</lineEnding>
      <fileMode>0644</fileMode>
    </file>
    <file>
      <source>${maven.multiModuleProjectDirectory}/NOTICE</source>
      <lineEnding>unix</lineEnding>
      <fileMode>0644</fileMode>
    </file>
  </files>

  <fileSets>
    <!-- the module's src/dist/files/, as jtools-dist carries it: VOICES.md, the voices' credits -->
    <fileSet>
      <directory>src/dist/files</directory>
      <outputDirectory>.</outputDirectory>
      <lineEnding>unix</lineEnding>
      <fileMode>0644</fileMode>
    </fileSet>
    <!-- the runtime jlink linked (jtools-parent): its executables 0755, the rest 0644 -->
    <fileSet>
      <directory>${project.build.directory}/runtime/linux</directory>
      <outputDirectory>jre</outputDirectory>
      <includes>
        <include>bin/**</include>
        <include>lib/jspawnhelper</include>
        <include>lib/jexec</include>
      </includes>
      <fileMode>0755</fileMode>
      <directoryMode>0755</directoryMode>
    </fileSet>
    <fileSet>
      <directory>${project.build.directory}/runtime/linux</directory>
      <outputDirectory>jre</outputDirectory>
      <excludes>
        <exclude>bin/**</exclude>
        <exclude>lib/jspawnhelper</exclude>
        <exclude>lib/jexec</exclude>
      </excludes>
      <fileMode>0644</fileMode>
      <directoryMode>0755</directoryMode>
    </fileSet>
    <!-- Piper: its programs executable, the rest not -->
    <fileSet>
      <directory>${project.build.directory}/piper/linux</directory>
      <outputDirectory>piper</outputDirectory>
      <includes>
        <include>piper</include>
        <include>piper_phonemize</include>
        <include>espeak-ng</include>
      </includes>
      <fileMode>0755</fileMode>
      <directoryMode>0755</directoryMode>
    </fileSet>
    <fileSet>
      <directory>${project.build.directory}/piper/linux</directory>
      <outputDirectory>piper</outputDirectory>
      <excludes>
        <exclude>piper</exclude>
        <exclude>piper_phonemize</exclude>
        <exclude>espeak-ng</exclude>
        <exclude>pkgconfig/**</exclude>
      </excludes>
      <fileMode>0644</fileMode>
      <directoryMode>0755</directoryMode>
    </fileSet>
    <fileSet>
      <directory>${maven.multiModuleProjectDirectory}/external/voices</directory>
      <outputDirectory>voices</outputDirectory>
      <includes>
        <include>*.onnx</include>
        <include>*.onnx.json</include>
      </includes>
      <fileMode>0644</fileMode>
      <directoryMode>0755</directoryMode>
    </fileSet>
  </fileSets>
</assembly>
