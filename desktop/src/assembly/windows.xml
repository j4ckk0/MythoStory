<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows distribution: jtools-parent's — the jar, its launchers, the runtime jlink linked — with Piper and its voices. -->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
  <id>windows</id>
  <formats>
    <format>zip</format>
  </formats>
  <baseDirectory>${jtools.app.id}-${project.version}</baseDirectory>

  <files>
    <file>
      <source>${project.build.directory}/${project.build.finalName}.jar</source>
      <destName>${jtools.app.id}.jar</destName>
    </file>
    <!-- the launchers jtools-parent's distributions made: without a console, and in one -->
    <file>
      <source>${project.build.directory}/${jtools.app.name}.exe</source>
    </file>
    <file>
      <source>${project.build.directory}/jtools-dist-work/windows/app.bat</source>
      <destName>${jtools.app.id}.bat</destName>
      <lineEnding>crlf</lineEnding>
    </file>
    <file>
      <source>src/dist/${jtools.app.id}.ini</source>
      <lineEnding>crlf</lineEnding>
    </file>
    <file>
      <source>${maven.multiModuleProjectDirectory}/README.md</source>
      <lineEnding>crlf</lineEnding>
    </file>
    <file>
      <source>${maven.multiModuleProjectDirectory}/LICENSE</source>
      <lineEnding>crlf</lineEnding>
    </file>
    <file>
      <source>${maven.multiModuleProjectDirectory}/NOTICE</source>
      <lineEnding>crlf</lineEnding>
    </file>
  </files>

  <fileSets>
    <!-- the module's src/dist/files/, as jtools-dist carries it: VOICES.md, the voices' credits -->
    <fileSet>
      <directory>src/dist/files</directory>
      <outputDirectory>.</outputDirectory>
      <lineEnding>crlf</lineEnding>
    </fileSet>
    <fileSet>
      <directory>${project.build.directory}/runtime/windows</directory>
      <outputDirectory>jre</outputDirectory>
    </fileSet>
    <fileSet>
      <directory>${project.build.directory}/piper/windows</directory>
      <outputDirectory>piper</outputDirectory>
      <excludes>
        <exclude>pkgconfig/**</exclude>
      </excludes>
    </fileSet>
    <!-- the licences of Piper's components, which its own archive leaves out, and where eSpeak NG's source is -->
    <fileSet>
      <directory>src/dist/piper-licences</directory>
      <outputDirectory>piper/licences</outputDirectory>
    </fileSet>
    <fileSet>
      <directory>${maven.multiModuleProjectDirectory}/external/voices</directory>
      <outputDirectory>voices</outputDirectory>
      <includes>
        <include>*.onnx</include>
        <include>*.onnx.json</include>
      </includes>
    </fileSet>
  </fileSets>
</assembly>
