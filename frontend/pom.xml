<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jtools</groupId>
    <artifactId>mythostory-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>mythostory-frontend</artifactId>
  <packaging>jar</packaging>

  <name>MythoStory frontend</name>
  <description>The Angular page, as a jar of static/ resources the backend serves. Built by npm, which jtools-parent runs: the npm of PATH, external/node's when the scripts run Maven (README: Externals).</description>

  <properties>
    <!-- the page's npm build is jtools-parent's (its profile jtools-frontend, switched on by angular.json): npm install
         (npm ci from scripts/linux/ci.sh), npm run build into target/angular, its browser/ as static/ in this jar, the
         vitest tests. The page uses nothing of @jtools/web: not unpacked. -->
    <jtools.weblib.skip>true</jtools.weblib.skip>
  </properties>

  <build>
    <plugins>
      <!-- MythoStory's LICENSE and NOTICE in the page, as static/licences/LICENSE.txt and NOTICE.txt (served as text):
           the help page links them, on the desktop and on Android alike — the Apache License's text, which the
           libraries under it ask to go with them too -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>licence</id>
            <phase>process-classes</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <copy file="${maven.multiModuleProjectDirectory}/LICENSE" tofile="${project.build.outputDirectory}/static/licences/LICENSE.txt" failonerror="true"/>
                <copy file="${maven.multiModuleProjectDirectory}/NOTICE" tofile="${project.build.outputDirectory}/static/licences/NOTICE.txt" failonerror="true"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
